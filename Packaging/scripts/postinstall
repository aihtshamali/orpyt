#!/bin/zsh
# Launch Orpyt immediately after installation for the current user.
# $USER is set by the installer to the installing user.

APP="/Applications/Orpyt.app"

if [[ -d "$APP" ]]; then
    # Strip quarantine so Gatekeeper doesn't block the first launch.
    # PKG installer runs as root so this always has permission.
    /usr/bin/xattr -dr com.apple.quarantine "$APP" 2>/dev/null || true

    # Use launchctl to open in the user's GUI session (works for PKG installs)
    if [[ -n "$USER" ]]; then
        uid=$(id -u "$USER" 2>/dev/null)
        if [[ -n "$uid" ]]; then
            launchctl asuser "$uid" open -a "$APP" &
        fi
    fi
fi

exit 0

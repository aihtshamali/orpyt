#!/bin/zsh

APP="/Applications/Orpyt.app"

if [[ ! -d "$APP" ]]; then
    exit 0
fi

# Strip quarantine so the first launch is clean after PKG install.
/usr/bin/xattr -dr com.apple.quarantine "$APP" 2>/dev/null || true

# Installer runs as root, so $USER is not reliable. Resolve the active console user
# and launch Orpyt into that GUI session.
console_user=$(/usr/sbin/scutil <<< "show State:/Users/ConsoleUser" | /usr/bin/awk '/Name :/ && $3 != "loginwindow" { print $3 }' | /usr/bin/head -n 1)

if [[ -n "$console_user" ]]; then
    uid=$(/usr/bin/id -u "$console_user" 2>/dev/null)
    if [[ -n "$uid" ]]; then
        /bin/launchctl asuser "$uid" /usr/bin/open -gj -a "$APP" >/dev/null 2>&1 &
    fi
fi

exit 0
